datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id Int @id @default(autoincrement())

    email    String @unique
    username String
    password String

    provider   String?
    providerId String?

    isVerified Boolean @default(false)

    verificationCode VerificationCode?
    likedSongs       LikedSong[]
    pinnedAlbums     AlbumsPinned[]
    pinnedArtists    ArtistsPinned[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationCode {
    id Int @id @default(autoincrement())

    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId Int  @unique

    code String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, code])
}

model Song {
    id Int @id @default(autoincrement())

    title    String
    duration Int
    audioUrl String

    album   Album @relation(fields: [albumId], references: [id])
    albumId Int

    artist   Artist @relation(fields: [artistId], references: [id])
    artistId Int

    usersLiked LikedSong[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model LikedSong {
    id Int @id @default(autoincrement())

    song   Song @relation(fields: [songId], references: [id])
    songId Int

    user   User @relation(fields: [userId], references: [id])
    userId Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([songId, userId])
}

model Artist {
    id Int @id @default(autoincrement())

    name         String
    heroImageUrl String

    songs    Song[]
    albums   Album[]
    pinnedBy ArtistsPinned[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Album {
    id Int @id @default(autoincrement())

    title       String
    imageUrl    String
    releaseYear Int

    artist   Artist @relation(fields: [artistId], references: [id])
    artistId Int

    songs    Song[]
    pinnedBy AlbumsPinned[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AlbumsPinned {
    id Int @id @default(autoincrement())

    user   User @relation(fields: [userId], references: [id])
    userId Int

    album   Album @relation(fields: [albumId], references: [id])
    albumId Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([albumId, userId])
}

model ArtistsPinned {
    id Int @id @default(autoincrement())

    user   User @relation(fields: [userId], references: [id])
    userId Int

    artist   Artist @relation(fields: [artistId], references: [id])
    artistId Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([artistId, userId])
}
